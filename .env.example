# wingman secrets. `wingman init` copies this to .env; fill in what you use. Never commit .env.

# ---- Required: Claude (drafting, ranking, profile). Or run `ant auth login` and leave this unset.
ANTHROPIC_API_KEY=

# ---- Bluesky: your handle and an APP PASSWORD (Settings -> Privacy and security -> App passwords),
# never your main password. App passwords can be revoked any time.
BLUESKY_HANDLE=
BLUESKY_APP_PASSWORD=

# ---- Mastodon: an access token from YOUR instance (Preferences -> Development -> New application,
# scopes: read, write:statuses). Set the instance itself in wingman.toml. Revoke it there any time.
MASTODON_ACCESS_TOKEN=

# ---- GitHub Discussions: a classic personal access token with the `public_repo` scope
# (Settings -> Developer settings -> Personal access tokens -> Tokens (classic)).
# Leave empty to use the token of a logged-in GitHub CLI (`gh auth login`).
GITHUB_TOKEN=

# ---- Hacker News: no credentials (wingman only reads; you submit from your browser). Optional: your
# username, so your own stories are skipped and `wingman stats` can read your comments.
HN_USERNAME=

# ---- Reddit, mode = "api" only (needs Reddit API approval; see README):
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USERNAME=
REDDIT_PASSWORD=
# Reddit, mode = "manual": your private front-page RSS link from https://www.reddit.com/prefs/feeds
# (treat it like a password). REDDIT_USERNAME above is also used in this mode.
REDDIT_FRONTPAGE_FEED=

# ---- Jobs (`wingman jobs scan`): a free Adzuna API key from https://developer.adzuna.com
# (both values are on your dashboard). Not needed for `wingman jobs draft` with a copied ad.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# ---- Optional
# OLLAMA_HOST=localhost:11434   # where Ollama runs, for semantic search in drafts (`wingman index`)
